def eh_primo(n: int) -> bool:
    if n < 2:
        return False
    i: int = 2
    while i * i <= n:
        if n % i == 0:
            return False
        i += 1
    return True

def main() -> None:
    limite: int = int(input())
    i: int = 2
    while i <= limite:
        if eh_primo(i):
            print(str(i))
        i += 1

main()
