def busca_binaria(arr: list[int], val: int) -> int:
    esq: int = 0
    dir: int = len(arr) - 1
    while esq <= dir:
        meio: int = (esq + dir) // 2
        if arr[meio] == val:
            return meio
        elif arr[meio] < val:
            esq = meio + 1
        else:
            dir = meio - 1
    return -1

def main() -> None:
    n: int = int(input())
    arr: list[int] = []
    i: int = 0
    while i < n:
        append(arr, int(input()))
        i += 1
    val: int = int(input())
    print(str(busca_binaria(arr, val)))

main()
