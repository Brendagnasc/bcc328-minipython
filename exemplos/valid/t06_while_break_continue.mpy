
def main() -> None:
    i: int = 0
    while i < 5:
        print(str(i))
        i += 1

    j: int = 1
    while j <= 100:
        if j % 7 == 0:
            print("primeiro multiplo de 7: " + str(j))
            break
        j += 1

    k: int = 0
    while k < 10:
        k += 1
        if k % 2 == 0:
            continue
        print(str(k))

    x: int = 0
    while x < 3:
        y: int = 0
        while y < 3:
            if y == 2:
                break
            print(str(x) + "," + str(y))
            y += 1
        x += 1

main()
