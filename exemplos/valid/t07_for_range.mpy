
def main() -> None:
    for i in range(5):
        print(str(i))

    for i in range(3, 8):
        print(str(i))

    for i in range(0, 10, 2):
        print(str(i))

    for i in range(5, 0, -1):
        print(str(i))

    soma: int = 0
    for i in range(1, 101):
        soma += i
    print(str(soma))

    for i in range(1, 4):
        for j in range(1, 4):
            print(str(i) + "x" + str(j) + "=" + str(i * j))

main()
