
def dobro(x: int) -> int:
    return x * 2

def quadrado(x: int) -> int:
    return x * x

def negativo(x: int) -> int:
    return -x

def positivo(x: int) -> bool:
    return x > 0

def par(x: int) -> bool:
    return x % 2 == 0

def map(f: (int) -> int, xs: list[int]) -> list[int]:
    resultado: list[int] = []
    for x in xs:
        append(resultado, f(x))
    return resultado

def filter(pred: (int) -> bool, xs: list[int]) -> list[int]:
    resultado: list[int] = []
    for x in xs:
        if pred(x):
            append(resultado, x)
    return resultado

def fold(f: (int, int) -> int, xs: list[int], acc: int) -> int:
    for x in xs:
        acc = f(acc, x)
    return acc

def soma_dois(a: int, b: int) -> int:
    return a + b

def produto_dois(a: int, b: int) -> int:
    return a * b

def aplica_duas_vezes(f: (int) -> int, x: int) -> int:
    return f(f(x))

def main() -> None:
    nums: list[int] = [1, 2, 3, 4, 5, 6, 7, 8]

    dobrados: list[int] = map(dobro, nums)
    for x in dobrados:
        print(str(x))

    quadrados: list[int] = map(quadrado, nums)
    for x in quadrados:
        print(str(x))

    pares: list[int] = filter(par, nums)
    for x in pares:
        print(str(x))

    negativos: list[int] = map(negativo, nums)
    pos: list[int] = filter(positivo, negativos)
    print(str(len(pos)))

    print(str(fold(soma_dois, nums, 0)))
    print(str(fold(produto_dois, nums, 1)))

    print(str(aplica_duas_vezes(dobro, 3)))
    print(str(aplica_duas_vezes(quadrado, 2)))

main()
