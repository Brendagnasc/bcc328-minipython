
def conta_primos_em_intervalo(inicio: int, fim: int) -> int:
    count: int = 0
    for n in range(inicio, fim + 1):
        if n < 2:
            continue
        eh_primo: bool = True
        i: int = 2
        while i * i <= n:
            if n % i == 0:
                eh_primo = False
                break
            i += 1
        if eh_primo:
            count += 1
    return count

def triangulo(n: int) -> None:
    for i in range(1, n + 1):
        linha: str = ""
        for j in range(i):
            if j > 0:
                linha = linha + " "
            linha = linha + str(i)
        print(linha)

def main() -> None:
    resultado: list[int] = []
    for i in range(1, 4):
        for j in range(1, 4):
            soma: int = 0
            k: int = 0
            while k < i:
                if k % 2 == 0:
                    soma += j
                k += 1
            append(resultado, soma)

    for r in resultado:
        print(str(r))

    print(str(conta_primos_em_intervalo(1, 50)))

    triangulo(5)

main()
