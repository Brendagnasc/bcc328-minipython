def fib_rec(n: int) -> int:
    if n <= 1:
        return n
    return fib_rec(n - 1) + fib_rec(n - 2)

def fib_iter(n: int) -> int:
    if n <= 1:
        return n
    a: int = 0
    b: int = 1
    i: int = 2
    while i <= n:
        c: int = a + b
        a = b
        b = c
        i += 1
    return b

def main() -> None:
    for i in range(11):
        print(str(fib_rec(i)))
    for i in range(11):
        print(str(fib_iter(i)))

main()
