def repete(s: str, n: int) -> str:
    resultado: str = ""
    i: int = 0
    while i < n:
        resultado = resultado + s
        i += 1
    return resultado

def conta_char(s: str, c: str) -> int:
    n: int = 0
    i: int = 0
    while i < len(s):
        if s[i] == c:
            n += 1
        i += 1
    return n

def main() -> None:
    s1: str = "ola"
    s2: str = " mundo"
    print(s1 + s2)
    print(str(len(s1)))
    print(str(len(s2)))

    print(repete("ab", 4))
    print(str(conta_char("mississippi", "s")))

    vazia: str = ""
    print(str(len(vazia)))
    print(str(len(vazia) == 0))

    num: int = 2025
    print("ano: " + str(num))

main()
