cabal-version:      3.0
name:               minipython
version:            0.2.0.0
synopsis:           Compilador MiniPython: analise lexica e sintatica, tipos e interpretador (BCC328, UFOP)
license:            BSD-3-Clause
license-file:       LICENSE
author:             Brenda Gabrielle Alves Nascimento
category:           Language
build-type:         Simple
extra-doc-files:    CHANGELOG.md
                    README.md
                    docs/gramatica.md

-- Os testes leem os programas de exemplos/, entao eles precisam ir
-- junto no pacote gerado por cabal sdist.
extra-source-files: exemplos/**/*.mpy
                    exemplos/**/*.err
                    exemplos/**/*.in
                    exemplos/**/*.out
                    spec/minipython.md
                    report/relatorio.tex
                    report/uso-ia.tex
                    report/relatorio-tp2.tex
                    report/uso-ia-tp2.tex
                    testes/*.sh
                    testes/saidas-esperadas.txt
                    testes/saidas-tp2.txt

common warnings
    ghc-options: -Wall -Wcompat -Widentities -Wredundant-constraints -Werror

library
    import:           warnings
    exposed-modules:  MiniPython.CLI
                    , MiniPython.Utils.Error
                    , MiniPython.Frontend.Lexer.Token
                    , MiniPython.Frontend.Lexer.MiniPythonLexer
                    , MiniPython.Frontend.Lexer.Indent
                    , MiniPython.Frontend.Syntax.MiniPythonSyntax
                    , MiniPython.Frontend.Syntax.Validate
                    , MiniPython.Frontend.Pretty.MiniPythonPretty
                    , MiniPython.Frontend.Parser.RecursiveDescent
                    , MiniPython.Frontend.Parser.Stream
                    , MiniPython.Frontend.Parser.PEG
                    , MiniPython.Frontend.Parser.Happy.Grammar
                    , MiniPython.Semantic.Types
                    , MiniPython.Semantic.TypeChecker
                    , MiniPython.Interpreter.Value
                    , MiniPython.Interpreter.Interp
    build-depends:    base ^>=4.18.2.1
                    , containers >=0.6 && <0.8
                    , mtl >=2.2 && <2.4
                    , megaparsec >=9.5 && <10
                    , typed-peg >=0.6 && <0.7
                    , array >=0.5 && <0.6
    hs-source-dirs:   src
    build-tool-depends: happy:happy >=1.20
    default-language: Haskell2010

executable mpyc
    import:           warnings
    main-is:          Main.hs
    build-depends:    base ^>=4.18.2.1
                    , minipython
                    , containers >=0.6 && <0.8
                    , filepath >=1.4 && <1.6
    hs-source-dirs:   app
    default-language: Haskell2010

test-suite minipython-test
    import:           warnings
    type:             exitcode-stdio-1.0
    main-is:          Main.hs
    hs-source-dirs:   test
    build-depends:    base ^>=4.18.2.1
                    , minipython
                    , directory >=1.3 && <1.4
                    , filepath >=1.4 && <1.6
    default-language: Haskell2010
