cabal-version:      3.0
name:               minipython
version:            0.1.0.0
license:            BSD-3-Clause
license-file:       LICENSE
author:             Brenda Gabrielle Alves Nascimento
category:           Language
build-type:         Simple
extra-doc-files:    CHANGELOG.md

common warnings
    ghc-options: -Wall -Wcompat -Widentities -Wredundant-constraints -Werror

library
    import:           warnings
    exposed-modules:  MiniPython.CLI
                    , MiniPython.Frontend.Lexer.Token
                    , MiniPython.Frontend.Lexer.MiniPythonLexer
                    , MiniPython.Frontend.Lexer.Indent
                    , MiniPython.Frontend.Syntax.MiniPythonSyntax
                    , MiniPython.Frontend.Pretty.MiniPythonPretty
                    , MiniPython.Utils.Pretty
                    , MiniPython.Frontend.Parser.Core
                    , MiniPython.Frontend.Parser.Expr
                    , MiniPython.Frontend.Parser.RecursiveDescent
                    , MiniPython.Frontend.Parser.Stream
                    , MiniPython.Frontend.Parser.PEG
    build-depends:    base ^>=4.18.2.1
                    , pretty >=1.1 && <2
                    , megaparsec >=9.5 && <10
                    , parser-combinators >=1.3 && <2
    hs-source-dirs:   src
    default-language: Haskell2010

executable mpyc
    import:           warnings
    main-is:          Main.hs
    build-depends:    base ^>=4.18.2.1
                    , minipython
                    , megaparsec >=9.5 && <10
    hs-source-dirs:   app
    default-language: Haskell2010

test-suite minipython-test
    import:           warnings
    type:             exitcode-stdio-1.0
    main-is:          Main.hs
    hs-source-dirs:   test
    build-depends:    base ^>=4.18.2.1
                    , minipython
    default-language: Haskell2010
