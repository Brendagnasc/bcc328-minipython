cabal-version:      2.4
name:               mpyc
version:            0.1.0.0
synopsis:           Compilador MiniPython (BCC328)
author:             Brenda Gabrielle Alves Nascimento
build-type:         Simple

library
    hs-source-dirs:   src
    exposed-modules:  MiniPython.CLI
    build-depends:    base >=4.17 && <5
    default-language: Haskell2010
    ghc-options:      -Wall -Wcompat -Widentities -Wredundant-constraints -Werror

executable mpyc
    hs-source-dirs:   app
    main-is:          Main.hs
    build-depends:    base >=4.17 && <5, mpyc
    default-language: Haskell2010
    ghc-options:      -Wall -Werror
